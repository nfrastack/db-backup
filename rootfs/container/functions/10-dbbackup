dbbackup_check_availability() {
    if var_true "${DEBUG_CHECK_AVAILABILITY}" ; then dbbackup_debug on; fi
    ### Set the Database Type
    if var_false "${backup_job_skip_availability_check}" ; then
        case "${dbtype}" in
            "couch" )
                counter=0
                code_received=0
                while [ "${code_received}" != "200" ]; do
                    code_received=$(dbbackup_run_as_user curl -XGET -sSL -o /dev/null -L -w ''%{http_code}'' ${backup_job_db_host}:${backup_job_db_port})
                    if [ "${code_received}" = "200" ] ; then break ; fi
                    sleep 5
                    (( counter+=5 ))
                    dbbackup_write_log warn "CouchDB Host '${backup_job_db_host}' is not accessible, retrying.. ($counter seconds so far)"
                done
            ;;
            "influx" )
                counter=0
                case "${backup_job_influx_version,,}" in
                    1 )
                        while ! (dbbackup_run_as_user nc -z ${backup_job_db_host#*//} ${backup_job_db_port}) ; do
                            sleep 5
                            (( counter+=5 ))
                            dbbackup_write_log warn "InfluxDB Host '${backup_job_db_host#*//}' is not accessible, retrying.. ($counter seconds so far)"
                        done
                    ;;
                    2 )
                        code_received=0
                        while [ "${code_received}" != "200" ]; do
                            code_received=$(dbbackup_run_as_user curl -XGET -sSL -o /dev/null -w ''%{http_code}'' ${backup_job_db_host}:${backup_job_db_port}/health)
                            if [ "${code_received}" = "200" ] ; then break ; fi
                            sleep 5
                            (( counter+=5 ))
                            dbbackup_write_log warn "InfluxDB Host '${backup_job_db_host}' is not accessible, retrying.. ($counter seconds so far)"
                        done
                    ;;
                esac
            ;;
            "mongo" )
                if [ -n "${backup_job_mongo_custom_uri}" ] ; then
                    dbbackup_write_log debug "Skipping Connectivity Check"
                else
                    counter=0
                    while ! (dbbackup_run_as_user nc -z ${backup_job_db_host} ${backup_job_db_port}) ; do
                        sleep 5
                        (( counter+=5 ))
                        dbbackup_write_log warn "Mongo Host '${backup_job_db_host}' is not accessible, retrying.. ($counter seconds so far)"
                    done
                fi
            ;;
            "mysql" )
                counter=0
                export MYSQL_PWD=${backup_job_db_pass}
                while ! (dbbackup_run_as_user ${_mysql_prefix}/${_mysqladmin_bin} -u"${backup_job_db_user}" -P"${backup_job_db_port}" -h"${backup_job_db_host}" ${mysql_tls_args} status > /dev/null 2>&1) ; do
                    sleep 5
                    (( counter+=5 ))
                    dbbackup_write_log warn "MySQL/MariaDB Server '${backup_job_db_host}' is not accessible, retrying.. (${counter} seconds so far)"
                done
            ;;
            "mssql" )
                counter=0
                while ! (dbbackup_run_as_user nc -z ${backup_job_db_host} ${backup_job_db_port}) ; do
                    sleep 5
                    (( counter+=5 ))
                    dbbackup_write_log warn "MSSQL Host '${backup_job_db_host}' is not accessible, retrying.. ($counter seconds so far)"
                done
            ;;
            "pgsql" )
                counter=0
                until dbbackup_run_as_user pg_isready --host=${backup_job_db_host} --port=${backup_job_db_port} -q
                do
                    sleep 5
                    (( counter+=5 ))
                    dbbackup_write_log warn "Postgres Host '${backup_job_db_host}' is not accessible, retrying.. ($counter seconds so far)"
                done
            ;;
            "redis" )
                counter=0
                while ! (dbbackup_run_as_user nc -z "${backup_job_db_host}" "${backup_job_db_port}") ; do
                    sleep 5
                    (( counter+=5 ))
                    dbbackup_write_log warn "Redis Host '${backup_job_db_host}' is not accessible, retrying.. ($counter seconds so far)"
                done
            ;;
            "sqlite3" )
                if [[ ! -e "${backup_job_db_host}" ]]; then
                    dbbackup_write_log error "File '${backup_job_db_host}' does not exist."
                    exit_code=2
                    exit $exit_code
                elif [[ ! -f "${backup_job_db_host}" ]]; then
                    dbbackup_write_log error "File '${backup_job_db_host}' is not a file."
                    exit_code=2
                    exit $exit_code
                elif [[ ! -r "${backup_job_db_host}" ]]; then
                    dbbackup_write_log error "File '${backup_job_db_host}' is not readable."
                    exit_code=2
                    exit $exit_code
                fi
            ;;
        esac
    fi
    if var_true "${DEBUG_CHECK_AVAILABILITY}" ; then dbbackup_debug off; fi
}

dbbackup_check_exit_code() {
    if var_true "${DEBUG_CHECK_EXIT_CODE}" ; then dbbackup_debug on; fi
    case "${1}" in
        backup )
            dbbackup_write_log debug "DB Backup exit Code is ${exit_code}"
            case "${exit_code}" in
                0 )
                    dbbackup_write_log info "DB Backup of '${2}' completed successfully"
                ;;
                * )
                    dbbackup_write_log error "DB Backup of '${2}' reported errors"
                    dbbackup_notify \
                        "$(date -d @"${backup_job_start_time}" +'%Y%m%d_%H%M%S')" \
                        "${LOG_PATH}/$(date +'%Y%m%d')/$(date -d @${backup_job_start_time} +'%Y%m%d_%H%M%S')-${backup_job_filename_base}.log" \
                        "${exit_code}" \
                        "[FATAL] Host: ${backup_job_db_host} Name: ${backup_job_db_name} - Backup failed completely" \
                        "DB Backup is failing to backup the '${backup_job_db_host}-${backup_job_db_name}' job."
                    master_exit_code=1
                ;;
            esac
            ;;
        move )
            dbbackup_write_log debug "Move exit Code is ${exit_code}"
            case "${move_exit_code}" in
                0 )
                    dbbackup_write_log debug "Moving of backup '${2}' completed successfully"
                ;;
                * )
                    dbbackup_write_log error "Moving of backup '${2}' reported errors"
                    dbbackup_notify \
                        "$(date -d @"${backup_job_start_time}" +'%Y%m%d_%H%M%S')" \
                        "${LOG_PATH}/$(date +'%Y%m%d')/$(date -d @${backup_job_start_time} +'%Y%m%d_%H%M%S')-${backup_job_filename_base}.log" \
                        "${move_exit_code}" \
                        "[FATAL] Host: ${backup_job_db_host} Name: ${backup_job_db_name} - Backup failed to move to destination" \
                        "DB Backup is failing to backup the '${backup_job_db_host}-${backup_job_db_name}' job."
                    master_exit_code=1
                ;;
            esac
        ;;
    esac
    if var_true "${DEBUG_CHECK_EXIT_CODE}" ; then dbbackup_debug off; fi
}

dbbackup_cleanup_old_data() {
    if var_true "${DEBUG_CLEANUP_OLD_DATA}" ; then dbbackup_debug on; fi
    if [ -n "${backup_job_cleanup_time}" ]; then
        if [ "${master_exit_code}" != 1 ]; then
            case "${backup_job_backup_location,,}" in
                "blobxfer" )
                    dbbackup_write_log info "Cleaning up old backups on filesystem"
                    dbbackup_run_as_user mkdir -p "${backup_job_filesystem_path}"
                    find "${backup_job_filesystem_path}"/  -type f -mmin +"${backup_job_cleanup_time}" -iname "${backup_job_filename_base}*" -exec rm -f {} \;
                    if var_true "${_postgres_backup_globals}"; then
                        find "${backup_job_filesystem_path}"/  -type f -mmin +"${backup_job_cleanup_time}" -iname "${backup_job_global_base}*" -exec rm -f {} \;
                    fi

                    if  [ -z "${backup_job_blobxfer_storage_account}" ] || [ -z "${backup_job_blobxfer_storage_account_key}" ]; then
                        dbbackup_write_log warn "Variable _BLOBXFER_STORAGE_ACCOUNT or _BLOBXFER_STORAGE_ACCOUNT_KEY is not set. Skipping blobxfer functions"
                    else
                        dbbackup_write_log info "Syncing changes via blobxfer"
                        silent dbbackup_run_as_user blobxfer upload --no-overwrite --mode ${backup_job_blobxfer_mode} --remote-path ${backup_job_blobxfer_remote_path} --storage-account ${backup_job_blobxfer_storage_account} --storage-account-key ${backup_job_blobxfer_storage_account_key} --local-path ${backup_job_filesystem_path} --delete --delete-only
                    fi
                ;;
                "file" | "filesystem" )
                    dbbackup_write_log info "Cleaning up old backups on filesystem"
                    dbbackup_run_as_user mkdir -p "${backup_job_filesystem_path}"
                    dbbackup_run_as_user find "${backup_job_filesystem_path}"/  -type f -mmin +"${backup_job_cleanup_time}" -iname "${backup_job_filename_base}*" -exec rm -f {} \;
                    if var_true "${_postgres_backup_globals}"; then
                        dbbackup_run_as_user find "${backup_job_filesystem_path}"/  -type f -mmin +"${backup_job_cleanup_time}" -iname "${backup_job_global_base}*" -exec rm -f {} \;
                    fi
                ;;
                "s3" | "minio" )
                    dbbackup_write_log info "Cleaning up old backups on S3 storage"
                    dbbackup_run_as_user aws ${PARAM_AWS_ENDPOINT_URL} s3 ls s3://${backup_job_s3_bucket}/${backup_job_s3_path}/ ${s3_ssl} ${s3_ca_cert} ${backup_job_s3_extra_opts} | grep " DIR " -v | grep " PRE " -v | while read -r s3_file; do
                        s3_createdate=$(echo $s3_file | awk {'print $1" "$2'})
                        s3_createdate=$(date -d "$s3_createdate" "+%s")
                        s3_olderthan=$(echo $(( $(date +%s)-${backup_job_cleanup_time}*60 )))
                        if [[ $s3_createdate -le $s3_olderthan ]] ; then
                            s3_filename=$(echo $s3_file | awk {'print $4'})
                            if [ "$s3_filename" != "" ] ; then
                                dbbackup_write_log debug "Deleting $s3_filename"
                                dbbackup_run_as_user aws ${PARAM_AWS_ENDPOINT_URL} s3 rm s3://${backup_job_s3_bucket}/${backup_job_s3_path}/${s3_filename} ${s3_ssl} ${s3_ca_cert} ${backup_job_s3_extra_opts}
                            fi
                        fi
                    done
                ;;
            esac
        else
            dbbackup_write_log error "Skipping Cleaning up old backups because there were errors in backing up"
        fi
    fi
    if var_true "${DEBUG_CLEANUP_OLD_DATA}" ; then dbbackup_debug off; fi
}

dbbackup_compression() {
    if var_true "${DEBUG_COMPRESSION}" ; then dbbackup_debug on; fi
    if var_false "${backup_job_parallel_compression}" ; then
        backup_job_parallel_compression_threads=1
    fi

    if var_true "${backup_job_gz_rsyncable}" ; then
        gz_rsyncable=--rsyncable
    fi

    case "${backup_job_compression,,}" in
        bz* )
            print_debug "[compression] Selected BZIP"
            compress_cmd="${play_fair} pbzip2 -q -${backup_job_compression_level} -p${backup_job_parallel_compression_threads} "
            compression_type="bzip2"
            dir_compress_cmd=${compress_cmd}
            extension=".bz2"
            backup_job_filename_dir=${backup_job_filename}
            backup_job_filename=${backup_job_filename}.bz2
        ;;
        gz* )
            print_debug "[compression] Selected GZIP"
            compress_cmd="${play_fair} pigz -q -${backup_job_compression_level} -p ${backup_job_parallel_compression_threads} ${gz_rsyncable}"
            compression_type="gzip"
            extension=".gz"
            dir_compress_cmd=${compress_cmd}
            backup_job_filename_dir=${backup_job_filename}
            backup_job_filename=${backup_job_filename}.gz
        ;;
        xz* )
            print_debug "[compression] Selected XZIP"
            compress_cmd="${play_fair} pixz -${backup_job_compression_level} -p ${backup_job_parallel_compression_threads} "
            compression_type="xzip"
            dir_compress_cmd=${compress_cmd}
            extension=".xz"
            backup_job_filename_dir=${backup_job_filename}
            backup_job_filename=${backup_job_filename}.xz
        ;;
        zst* )
            print_debug "[compression] Selected ZSTD"
            compress_cmd="${play_fair} zstd -q -q --rm -${backup_job_compression_level} -T${backup_job_parallel_compression_threads} ${gz_rsyncable}"
            compression_type="zstd"
            dir_compress_cmd=${compress_cmd}
            extension=".zst"
            backup_job_filename_dir=${backup_job_filename}
            backup_job_filename=${backup_job_filename}.zst
        ;;
        "none" | "false")
            compress_cmd="cat "
            compression_type="none"
            dir_compress_cmd="cat "
            backup_job_filename_dir=${backup_job_filename}
        ;;
    esac

    case "${CONTAINER_LOG_LEVEL,,}" in
        "debug" )
            if [ "${compression_type}" = "none" ] ; then
                compression_string="with '${backup_job_parallel_compression_threads}' threads"
            else
                compression_string="and compressing with '${compression_type}:${backup_job_compression_level}' with '${backup_job_parallel_compression_threads}' threads"
            fi
        ;;
        * )
            if [ "${compression_type}" != "none" ] ; then
                compression_string="and compressing with '${compression_type}'"
            fi
        ;;
    esac
    if var_true "${DEBUG_COMPRESSION}" ; then dbbackup_debug off; fi
}

dbbackup_create_archive() {
    if var_true "${DEBUG_CREATE_ARCHIVE}" ; then dbbackup_debug on; fi
    if [ "${exit_code}" = "0" ] ; then
        dbbackup_write_log notice "Creating archive file of '${backup_job_filename}' with tar ${compression_string}"
        dbbackup_run_as_user tar cf - "${temporary_directory}"/"${backup_job_filename_dir}" | ${dir_compress_cmd} | dbbackup_run_as_user tee "${temporary_directory}"/"${backup_job_filename_dir}".tar"${extension}" > /dev/null
        backup_job_filename="${backup_job_filename_dir}".tar"${extension}"
        rm -rf "${temporary_directory}"/"${backup_job_filename_dir}"
    else
        dbbackup_write_log error "Skipping creating archive file because backup did not complete successfully"
    fi
    if var_true "${DEBUG_CREATE_ARCHIVE}" ; then dbbackup_debug off; fi
}

dbbackup_create_schedulers() {
    if var_true "${DEBUG_CREATE_SCHEDULERS}" ; then dbbackup_debug on; fi

    _create_scheduler_instance() {
        local instance=${1}
        cp -R /container/data/dbbackup/template-dbbackup /container/run/available/dbbackup-"${instance}"
        sed -i "s|{{BACKUP_NUMBER}}|${instance}|g" /container/run/available/dbbackup-"${instance}"/run
        if [ "${MODE,,}" = "manual" ] ; then service_stop dbbackup-"${instance}" ; fi
        write_file root:root@/usr/bin/backup"${instance}"-now:755 <<EOF
#!/bin/bash
source /container/base/functions/container/init
SERVICE_NAME=db-backup${instance}
print_info "Starting Manual Backup for db-backup${instance}"
/container/run/available/dbbackup-${instance}/run now
EOF
        if [ "${instance}" = "01" ] ; then
            write_file root:root@/usr/bin/backup-now:755 <<EOF
#!/bin/bash
/usr/bin/backup01-now now
EOF
        else
            write_file -a root:root@/usr/bin/backup-now:755 <<EOF
/usr/bin/backup${instance}-now now
EOF
        fi
    }

    case "${1}" in
        backup )
            local backup_instances=$(set -o posix ; set | grep -Pc "^(DB[0-9]._HOST=|.*MONGO_CUSTOM_URI=)")
            print_debug "[create_schedulers] Found '${backup_instances}' DB_HOST instances"

            if [ -n "${DB_HOST}" ] && [ "${backup_instances}" = 0 ]; then
                backup_instances=1
                print_debug "[create_schedulers] Detected using old DB_ variables"
            fi

            if [ "${backup_instances}" -gt 0 ]; then
                floop "${backup_instances}" _create_scheduler_instance ")XX..10(BD"
            fi
            ;;
    esac
    if var_true "${DEBUG_CREATE_SCHEDULERS}" ; then dbbackup_debug off; fi
}

