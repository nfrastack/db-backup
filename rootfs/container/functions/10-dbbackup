dbbackup_backup_redis() {
    dbbackup_prepare_dbbackup
    dbbackup_write_log notice "Dumping Redis - Flushing Redis Cache First"
    backup_job_filename=redis_all_${backup_job_db_host,,}_${now}.rdb
    backup_job_filename_base=redis_${backup_job_db_host,,}
    if var_true "${DEBUG_BACKUP_REDIS}" ; then dbbackup_debug on; fi
    echo bgsave | silent dbbackup_run_as_user ${play_fair} redis-cli -h ${backup_job_db_host} -p ${backup_job_db_port} ${REDIS_PASS_STR} --rdb ${temporary_directory}/${backup_job_filename} ${backup_job_extra_opts} ${backup_job_extra_backup_opts}
    sleep 10
    try=5
    while [ $try -gt 0 ] ; do
        saved=$(echo 'info Persistence' | redis-cli -h ${backup_job_db_host} -p ${backup_job_db_port} ${REDIS_PASS_STR} | awk '/rdb_bgsave_in_progress:0/{print "saved"}')
        ok=$(echo 'info Persistence' | redis-cli -h ${backup_job_db_host} -p ${backup_job_db_port} ${REDIS_PASS_STR} | awk '/rdb_last_bgsave_status:ok/{print "ok"}')
        if [[ "$saved" = "saved" ]] && [[ "$ok" = "ok" ]]; then
            dbbackup_write_log notice "Redis Backup Complete"
            exit_code=0
            break
        fi
        try=$((try - 1))
        dbbackup_write_log warn "Redis Busy - Waiting and retrying in 5 seconds"
        sleep 5
    done
    backup_job_filename_original=${backup_job_filename}
    if var_true "${DEBUG_BACKUP_REDIS}" ; then dbbackup_debug off; fi
    dbbackup_compression
    dbbackup_pre_dbbackup all
    if var_true "${DEBUG_BACKUP_REDIS}" ; then dbbackup_debug on; fi
    dbbackup_run_as_user ${compress_cmd} "${temporary_directory}/${backup_job_filename_original}"
    if var_true "${DEBUG_BACKUP_REDIS}" ; then dbbackup_debug off; fi
    dbbackup_timer backup finish
    dbbackup_check_exit_code backup "${backup_job_filename}"
    dbbackup_file_encryption
    dbbackup_generate_checksum
    dbbackup_move_dbbackup
    dbbackup_check_exit_code move "${backup_job_filename}"
    dbbackup_post_dbbackup all
    dbbackup_cleanup_old_data
}

