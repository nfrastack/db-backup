source /container/base/functions/container/init
SERVICE_NAME="db-backup"
prepare_service defaults

CONFIG_FILE_PATH="${CONFIG_PATH%/}/${CONFIG_FILE}"
if [ ! -f "${CONFIG_FILE_PATH}" ]; then
    print_error "No config at ${CONFIG_FILE_PATH} - set DB* environment variables or mount a db-backup.yml config file"
    exit 1
fi

if [ "$#" -gt 0 ]; then
    JOB=""
    LOG_LEVEL=""
    for arg in "$@"; do
        case "${arg,,}" in
            debug | error | info | none | trace | warn)
                LOG_LEVEL="${arg,,}"
            ;;
            *)
                if [ -n "${JOB}" ]; then
                    print_error "Usage: backup-now [jobname] [debug|error|info|none|trace|warn]"
                    exit 1
                fi
                JOB="${arg}"
            ;;
        esac
    done

    LOG_LEVEL_ARGS=()
    if [ -n "${LOG_LEVEL}" ]; then
        LOG_LEVEL_ARGS=(--log-level "${LOG_LEVEL}")
    fi

    if [ -n "${JOB}" ]; then
        exec s6-setuidgid "${DBBACKUP_USER}" /app/dbb --container --config "${CONFIG_FILE_PATH}" "${LOG_LEVEL_ARGS[@]}" dump "${JOB}"
    fi

    exec s6-setuidgid "${DBBACKUP_USER}" /app/dbb --container --config "${CONFIG_FILE_PATH}" "${LOG_LEVEL_ARGS[@]}" scheduler --once
fi

# backup-now - run every job once in sequence
exec s6-setuidgid "${DBBACKUP_USER}" /app/dbb --container --config "${CONFIG_FILE_PATH}" scheduler --once
